{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-last-hair-realtime",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "ArenaRoom"
      },
      {
        "name": "LOBBY",
        "class_name": "ArenaLobby"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ArenaRoom",
        "ArenaLobby"
      ]
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://the-last-hair-roguelike.naturalred.chatgpt.site"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 0.1
  }
}